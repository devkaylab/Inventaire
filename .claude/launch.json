{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "metro",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}