{
  "expo": {
    "name": "Quantinvo",
    "slug": "quantinvo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quantinvo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quantinvo.app",
      "infoPlist": {
        "NSCameraUsageDescription": "L'accès à la caméra est nécessaire pour scanner les codes-barres des articles.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.quantinvo.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0912",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "L'accès à la caméra est nécessaire pour scanner les codes-barres des articles."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0912",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 160
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
